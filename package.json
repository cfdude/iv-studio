{
  "name": "iv-studio",
  "productName": "IV Studio",
  "version": "1.0.8",
  "description": "Infinite Variance studio for MiniMax H3: hunt previews, pick one, finish at 2 MP with DLSS. Built on ComfyUI, with an MCP server for agents.",
  "author": "Infinite Variance",
  "license": "MIT",
  "homepage": "https://infinitevariance.ai",
  "private": true,
  "main": "./out/main/index.js",
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "test": "node test/graph-parity.mjs",
    "test:unit": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/fakes/guard.mjs --test \"test/unit/*.test.mjs\"",
    "test:ui": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --import ./test/fakes/guard.mjs --test --test-concurrency=1 \"test/ui/*.test.mjs\"",
    "test:real": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test \"test/real/*.test.mjs\"",
    "dist": "electron-vite build && electron-builder --win --x64 --publish never",
    "dist:portable": "electron-vite build && electron-builder --win --x64 --publish never --config electron-builder.portable.cjs",
    "release": "electron-vite build && electron-builder --win --x64 --publish always",
    "dist:linux": "electron-vite build && electron-builder --linux --x64 --publish never",
    "dist:mac": "node scripts/mac-ffmpeg.mjs && electron-vite build && electron-builder --mac --publish never"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "electron-updater": "6.8.9",
    "ffmpeg-ffprobe-static": "6.1.2-rc.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@fontsource/barlow": "5.3.0",
    "@fontsource/barlow-condensed": "5.3.0",
    "@fontsource/dm-sans": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "electron": "44.9.0",
    "electron-builder": "26.15.3",
    "electron-vite": "6.0.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "vite": "8.3.4"
  },
  "build": {
    "appId": "ai.infinitevariance.studio",
    "productName": "IV Studio",
    "copyright": "Â© 2026 Infinite Variance",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "resources",
        "to": "resources"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "IV Studio",
      "uninstallDisplayName": "IV Studio",
      "artifactName": "IV-Studio-Setup.exe",
      "deleteAppDataOnUninstall": false
    },
    "publish": [
      {
        "provider": "github",
        "owner": "hollisorg",
        "repo": "iv-studio",
        "releaseType": "draft"
      }
    ],
    "asarUnpack": [
      "node_modules/ffmpeg-ffprobe-static/**"
    ],
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "executableName": "iv-studio",
      "artifactName": "IV-Studio.AppImage",
      "synopsis": "Make films with MiniMax H3 in your own ComfyUI",
      "desktop": {
        "entry": {
          "StartupWMClass": "IV Studio"
        }
      }
    },
    "mac": {
      "target": [
        "dmg",
        "zip"
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.video",
      "artifactName": "IV-Studio-mac-${arch}.${ext}",
      "minimumSystemVersion": "12.0"
    },
    "dmg": {
      "title": "IV Studio"
    }
  }
}
