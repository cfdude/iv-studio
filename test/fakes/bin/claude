#!/bin/sh
# A stand-in for the Claude Code CLI: prints one canned answer in its --output-format json shape.
# It reads nothing, opens no network connection and never touches the Keychain.
cat > /dev/null
printf '%s\n' '{"is_error":false,"result":"{\"canned\":true,\"engine\":\"claude\"}","structured_output":{"canned":true,"engine":"claude"}}'
